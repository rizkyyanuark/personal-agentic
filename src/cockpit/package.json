{
  "name": "@personal-agentic/cockpit",
  "version": "0.1.0",
  "description": "Read-only 3D office mounted in personal-agentic",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/client/index.d.ts",
      "import": "./src/client/mount.js"
    },
    "./styles.css": "./src/client/styles/main.css"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/unit/*.test.mjs",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "test:e2e": "node ../frontend/tests/cockpit-live.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "puppeteer": "^25.12.0",
    "vite": "^7.1.7"
  }
}
