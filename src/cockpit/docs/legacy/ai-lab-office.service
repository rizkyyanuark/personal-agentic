[Unit]
# Archived predecessor template; not used by personal-agentic.
Description=AI Lab Suite 3D Cockpit (ai-lab-cockpit)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/infra-hub/ai-lab-cockpit
ExecStart=/usr/bin/node /home/ubuntu/infra-hub/ai-lab-cockpit/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=8095
Environment=OFFICE_BIND_HOST=0.0.0.0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/ubuntu/infra-hub/ai-lab-cockpit
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
Alias=ai-lab-cockpit.service
